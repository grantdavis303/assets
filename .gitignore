# .gitignore

# List all files and directories you wish to ignore.
# See more here: https://git-scm.com/docs/gitignore

# Environment Files
*.env
*.env.*
!.env.example

# OS
/.DS_Store
**/.DS_Store
Thumbs.db

# Dependencies
node_modules

# Build Output
/dist
/dist-ssr

# Local Config
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Misc
coverage
.cache
*.tsbuildinfo

# Extra
/docs/

